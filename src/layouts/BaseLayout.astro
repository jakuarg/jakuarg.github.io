---
import '@/styles/global.css';
import type { Locale } from '@/site.config';
import SEO from '@/components/SEO.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Spotlight from '@/components/Spotlight.astro';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  noindex?: boolean;
}

const { locale, title, description, noindex } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#6d5ce7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1a24" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />

    <SEO locale={locale} title={title} description={description} noindex={noindex} />

    <script is:inline>
      // Se ejecuta antes del primer pintado para evitar el parpadeo de tema.
      (function () {
        var root = document.documentElement;

        // Solo se ocultan los bloques animados si el navegador puede revelarlos.
        if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          root.dataset.reveal = 'on';
        }

        try {
          var stored = localStorage.getItem('theme');
          var dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
          root.classList.toggle('dark', dark);
          root.style.colorScheme = dark ? 'dark' : 'light';
        } catch (error) {
          // localStorage bloqueado: se usa el tema claro por defecto.
        }
      })();
    </script>
  </head>

  <body class="min-h-dvh antialiased">
    <Header locale={locale} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <Spotlight />

    <script>
      // Aparición progresiva de bloques al entrar en el viewport.
      // El script de <head> ya decidió si la animación corresponde.
      if (document.documentElement.dataset.reveal === 'on') {
        const observer = new IntersectionObserver(
          (entries, self) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              self.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        document.querySelectorAll('.reveal').forEach((element) => observer.observe(element));
      }
    </script>
  </body>
</html>
