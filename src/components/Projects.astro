---
import type { Locale } from '@/site.config';
import { useTranslations } from '@/i18n/utils';
import { projects } from '@/data/content';
import Section from './Section.astro';
import ProjectGallery from './ProjectGallery.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Section id="projects" kicker={t('section.projects.kicker')} title={t('section.projects')}>
  <ul class="space-y-6">
    {
      projects.map((project) => (
        <li class="surface-card spotlight reveal p-6 transition-shadow duration-300 hover:shadow-xl sm:p-8">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <p class="text-brand-600 dark:text-brand-300 font-mono text-xs font-semibold tracking-wide uppercase">
              {project.org[locale]}
            </p>
            <p class="text-muted font-mono text-xs">
              {project.current ? `${project.period} — ${t('project.present')}` : project.period}
            </p>
          </div>

          <h3 class="mt-2 text-xl font-semibold sm:text-2xl">
            {project.href ? (
              <a
                href={project.href}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-brand-600 inline-flex items-center gap-2"
              >
                {project.title[locale]}
                <Icon name="external" class="size-4" />
              </a>
            ) : (
              project.title[locale]
            )}
          </h3>

          <p class="text-muted mt-3 leading-relaxed">{project.summary[locale]}</p>

          <ul class="mt-5 space-y-2.5">
            {project.highlights[locale].map((highlight) => (
              <li class="text-muted flex gap-3 text-sm leading-relaxed">
                <Icon name="arrowRight" class="text-brand-500 mt-1 size-3.5 shrink-0" />
                <span>{highlight}</span>
              </li>
            ))}
          </ul>

          {project.metrics && (
            <ul class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4" aria-label={t('project.metrics')}>
              {project.metrics.map((metric) => (
                <li class="border-subtle rounded-lg border px-3 py-2.5">
                  <p class="font-display text-brand-600 dark:text-brand-300 text-lg font-bold">{metric.value}</p>
                  <p class="text-muted text-xs">{metric.label[locale]}</p>
                </li>
              ))}
            </ul>
          )}

          <ProjectGallery project={project} locale={locale} />

          <div class="border-subtle mt-6 flex flex-wrap items-center justify-between gap-4 border-t pt-5">
            <p class="text-muted text-xs">
              <span class="font-semibold">{t('project.role')}:</span> {project.role[locale]}
            </p>
            <ul class="flex flex-wrap gap-2" aria-label={t('project.stack')}>
              {project.stack.map((tech) => (
                <li class="bg-brand-500/10 text-brand-700 dark:text-brand-300 rounded-md px-2.5 py-1 font-mono text-xs font-medium">
                  {tech}
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ul>
</Section>
