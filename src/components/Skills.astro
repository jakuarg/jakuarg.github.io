---
import type { Locale } from '@/site.config';
import { useTranslations } from '@/i18n/utils';
import { hardSkills, skillGroups, softSkills, type SkillGroup } from '@/data/content';
import type { UIKey } from '@/i18n/ui';
import Section from './Section.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/** Se arma la lista por grupo una sola vez, respetando el orden declarado. */
const porGrupo = skillGroups
  .map((grupo: SkillGroup) => ({
    grupo,
    titulo: t(`skills.group.${grupo}` as UIKey),
    habilidades: hardSkills.filter((skill) => skill.group === grupo),
  }))
  .filter((seccion) => seccion.habilidades.length > 0);
---

<Section id="skills" kicker={t('section.skills.kicker')} title={t('section.skills')}>
  <p class="reveal text-muted mb-8 max-w-prose text-sm">{t('skills.legend')}</p>

  <div class="space-y-8">
    {
      porGrupo.map(({ grupo, titulo, habilidades }) => (
        <section class="reveal" aria-labelledby={`skills-${grupo}`}>
          <h3 id={`skills-${grupo}`} class="text-muted mb-3 text-xs font-semibold tracking-[0.15em] uppercase">
            {titulo}
          </h3>
          <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {habilidades.map((skill) => (
              <li class="surface-card spotlight p-4">
                <div class="mb-1.5 flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                  <h4 class="font-display text-base font-semibold">{skill.name}</h4>
                  <span
                    class:list={[
                      'rounded-full px-2 py-0.5 text-xs font-medium',
                      skill.usage === 'proyectos'
                        ? 'bg-brand-500/10 text-brand-700 dark:text-brand-300'
                        : 'text-muted border-subtle border',
                    ]}
                  >
                    {t(`skills.usage.${skill.usage}` as UIKey)}
                  </span>
                </div>
                <p class="text-muted text-sm leading-relaxed">{skill.detail[locale]}</p>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <h3 class="reveal text-muted mt-12 mb-4 text-xs font-semibold tracking-[0.15em] uppercase">
    {t('section.skills.soft')}
  </h3>
  <ul class="reveal flex flex-wrap gap-2.5">
    {
      softSkills[locale].map((skill) => (
        <li class="border-subtle text-muted hover:border-brand-400 hover:text-brand-600 dark:hover:text-brand-300 inline-flex items-center gap-1.5 rounded-full border px-3.5 py-1.5 text-sm transition-colors">
          <Icon name="check" class="text-brand-500 size-3.5" />
          {skill}
        </li>
      ))
    }
  </ul>
</Section>
