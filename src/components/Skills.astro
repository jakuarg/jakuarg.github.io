---
import type { Locale } from '@/site.config';
import { useTranslations } from '@/i18n/utils';
import { hardSkills, softSkills } from '@/data/content';
import Section from './Section.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Section id="skills" kicker={t('section.skills.kicker')} title={t('section.skills')}>
  <h3 class="reveal text-muted mb-5 text-sm font-semibold tracking-wide uppercase">
    {t('section.skills.hard')}
  </h3>
  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      hardSkills.map((skill, index) => (
        <li
          class="surface-card spotlight reveal group p-5 transition-transform duration-300 hover:-translate-y-1"
          style={`transition-delay: ${index * 40}ms`}
        >
          <div class="mb-3 flex items-center justify-between gap-3">
            <h4 class="font-display text-base font-semibold">{skill.name}</h4>
            <span class="flex gap-1" role="img" aria-label={`${skill.level}/5`}>
              {Array.from({ length: 5 }, (_, i) => (
                <span
                  class:list={['size-1.5 rounded-full', i < skill.level ? 'bg-brand-500' : 'bg-[var(--border-subtle)]']}
                />
              ))}
            </span>
          </div>
          <p class="text-muted text-sm leading-relaxed">{skill.detail[locale]}</p>
        </li>
      ))
    }
  </ul>

  <h3 class="reveal text-muted mt-14 mb-5 text-sm font-semibold tracking-wide uppercase">
    {t('section.skills.soft')}
  </h3>
  <ul class="reveal flex flex-wrap gap-2.5">
    {
      softSkills[locale].map((skill) => (
        <li class="border-subtle text-muted hover:border-brand-400 hover:text-brand-600 dark:hover:text-brand-300 inline-flex items-center gap-1.5 rounded-full border px-3.5 py-1.5 text-sm transition-colors">
          <Icon name="check" class="text-brand-500 size-3.5" />
          {skill}
        </li>
      ))
    }
  </ul>
</Section>
