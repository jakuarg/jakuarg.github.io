---
import type { Locale } from '@/site.config';
import { useTranslations } from '@/i18n/utils';
import { profile, socials } from '@/data/content';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
// El año se fija en build; el sitio es estático y se reconstruye en cada deploy.
const year = new Date().getFullYear();
---

<footer class="border-subtle border-t py-10">
  <div
    class="text-muted mx-auto flex w-full max-w-5xl flex-col items-center justify-between gap-4 px-5 text-sm sm:flex-row sm:px-8"
  >
    <p>© {year} {profile.name}. {t('footer.rights')}</p>

    <div class="flex items-center gap-4">
      <p class="hidden sm:block">{t('footer.built')}</p>
      <ul class="flex gap-2">
        {
          socials.map((social) => (
            <li>
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-brand-600 dark:hover:text-brand-300 grid size-8 place-items-center transition-colors"
                aria-label={social.label}
              >
                <Icon name={social.icon} class="size-4" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
