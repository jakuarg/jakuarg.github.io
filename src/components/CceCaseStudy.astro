---
import type { Locale } from '@/site.config';
import { cceCaseStudy, projects } from '@/data/content';
import { localizePath } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import Section from './Section.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const project = projects.find((item) => item.slug === 'cce');

if (!project?.href) {
  throw new Error('El caso de estudio CCE requiere un proyecto con enlace público.');
}

const copy = {
  es: {
    back: 'Volver al inicio',
    visit: 'Visitar sitio institucional',
    platforms: 'Tres plataformas, una experiencia conectada',
    architecture: 'Recorrido de la información',
    mobile: 'Operación móvil sin conexión',
    metrics: 'Resultados medidos',
    stack: 'Ver tecnologías utilizadas',
    placeholder: 'Capturas del sistema pendientes de incorporar',
    placeholderText:
      'La presentación visual se preparó para recibir capturas reales con datos ficticios o anonimizados.',
  },
  en: {
    back: 'Back to home',
    visit: 'Visit institutional site',
    platforms: 'Three platforms, one connected experience',
    architecture: 'Information flow',
    mobile: 'Mobile operation without connectivity',
    metrics: 'Measured results',
    stack: 'View technologies used',
    placeholder: 'System screenshots are pending',
    placeholderText: 'The visual presentation is ready to receive real screenshots with fictional or anonymized data.',
  },
} as const;

const text = copy[locale];
const homeHref = localizePath('/', locale);
const meta = {
  es: {
    title: 'CCE — Centro de Calificaciones Estudiantiles | David Jacas Leila',
    description:
      'Caso de estudio del Centro de Calificaciones Estudiantiles: plataforma web, app Android offline-first y sitio institucional para el Colegio Agrotécnico N.º 2.',
  },
  en: {
    title: 'CCE — Student Grades Centre | David Jacas Leila',
    description:
      'Case study of the Student Grades Centre: a web platform, offline-first Android app and institutional site for Agrotechnical School No. 2.',
  },
} as const;
---

<BaseLayout locale={locale} title={meta[locale].title} description={meta[locale].description}>
  <section class="relative overflow-hidden py-16 sm:py-24" aria-labelledby="cce-title">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div
        class="from-brand-500/25 absolute -top-32 -left-24 size-[32rem] rounded-full bg-gradient-to-br to-transparent blur-3xl"
      >
      </div>
      <div
        class="from-accent-500/20 absolute -right-32 -bottom-40 size-[30rem] rounded-full bg-gradient-to-tl to-transparent blur-3xl"
      >
      </div>
    </div>

    <div class="mx-auto grid w-full max-w-5xl gap-12 px-5 sm:px-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
      <div>
        <a
          href={homeHref}
          class="text-muted hover:text-brand-600 dark:hover:text-brand-300 inline-flex items-center gap-2 text-sm font-semibold transition-colors"
        >
          <Icon name="arrowRight" class="size-4 rotate-180" />
          {text.back}
        </a>
        <p class="text-brand-600 dark:text-brand-300 mt-8 font-mono text-xs font-semibold tracking-[0.2em] uppercase">
          {cceCaseStudy.eyebrow[locale]}
        </p>
        <h1 id="cce-title" class="mt-3 text-4xl leading-[1.08] font-bold sm:text-5xl">
          {cceCaseStudy.title[locale]}
        </h1>
        <p class="text-muted mt-6 max-w-2xl text-base leading-relaxed sm:text-lg">{cceCaseStudy.lead[locale]}</p>
        <p
          class="border-brand-400/35 bg-brand-500/10 text-brand-700 dark:text-brand-200 mt-6 inline-flex rounded-full border px-3 py-1.5 text-sm font-medium"
        >
          {cceCaseStudy.status[locale]}
        </p>
        <p class="text-muted mt-6 max-w-2xl leading-relaxed">{cceCaseStudy.context[locale]}</p>
        <a
          href={project.href}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-brand-600 hover:bg-brand-700 mt-8 inline-flex items-center gap-2 rounded-full px-5 py-3 text-sm font-semibold text-white transition-colors"
        >
          {text.visit}
          <Icon name="external" class="size-4" />
        </a>
      </div>

      <aside class="surface-card spotlight reveal p-5 sm:p-6" aria-label={text.placeholder}>
        <div class="border-subtle rounded-xl border border-dashed p-5 sm:p-6">
          <div class="flex items-center justify-between gap-4">
            <p class="font-display text-lg font-bold">{text.placeholder}</p>
            <span
              class="bg-brand-500/10 text-brand-700 dark:text-brand-300 rounded-full px-2.5 py-1 font-mono text-xs font-semibold"
              >CCE</span
            >
          </div>
          <p class="text-muted mt-3 text-sm leading-relaxed">{text.placeholderText}</p>
          <ul class="mt-6 grid gap-3 sm:grid-cols-3" aria-label={text.platforms}>
            {
              cceCaseStudy.platforms.map((platform, index) => (
                <li class="border-subtle rounded-lg border p-3">
                  <p class="text-brand-600 dark:text-brand-300 font-mono text-xs font-bold">0{index + 1}</p>
                  <p class="mt-2 text-sm font-semibold">{platform.title[locale]}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <Section id="challenge" kicker={cceCaseStudy.eyebrow[locale]} title={cceCaseStudy.challenge.title[locale]}>
    <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr]">
      <p class="text-muted reveal text-lg leading-relaxed">{cceCaseStudy.challenge.lead[locale]}</p>
      <ul class="surface-card spotlight reveal space-y-4 p-6">
        {
          cceCaseStudy.challenge.items[locale].map((item) => (
            <li class="text-muted flex gap-3 leading-relaxed">
              <Icon name="check" class="text-brand-500 mt-1 size-4 shrink-0" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section id="platforms" kicker="CCE" title={text.platforms} class="bg-brand-500/[0.035] dark:bg-white/[0.02]">
    <ul class="grid gap-5 lg:grid-cols-3">
      {
        cceCaseStudy.platforms.map((platform) => (
          <li class="surface-card spotlight reveal flex flex-col p-6">
            <h2 class="font-display text-xl font-bold">{platform.title[locale]}</h2>
            <p class="text-muted mt-3 grow leading-relaxed">{platform.text[locale]}</p>
            <ul class="mt-5 flex flex-wrap gap-2" aria-label={`${platform.title[locale]} — tecnologías`}>
              {platform.stack.map((technology) => (
                <li class="bg-brand-500/10 text-brand-700 dark:text-brand-300 rounded-md px-2.5 py-1 font-mono text-xs font-medium">
                  {technology}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="architecture" kicker="Arquitectura" title={cceCaseStudy.architecture.title[locale]}>
    <p class="text-muted reveal max-w-3xl text-lg leading-relaxed">{cceCaseStudy.architecture.lead[locale]}</p>
    <div class="surface-card spotlight reveal mt-8 p-5 sm:p-8">
      <p class="text-brand-600 dark:text-brand-300 font-mono text-xs font-semibold tracking-[0.2em] uppercase">
        {text.architecture}
      </p>
      <ol class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          cceCaseStudy.architecture.flow[locale].map((stage, index) => (
            <li class="border-subtle relative rounded-lg border p-4">
              <p class="text-muted font-mono text-xs">0{index + 1}</p>
              <p class="mt-2 font-semibold">{stage}</p>
            </li>
          ))
        }
      </ol>
      <div class="border-subtle mt-5 border-t pt-5">
        <p class="text-brand-600 dark:text-brand-300 font-mono text-xs font-semibold tracking-[0.2em] uppercase">
          {text.mobile}
        </p>
        <p class="text-muted mt-3 max-w-3xl leading-relaxed">{cceCaseStudy.architecture.mobile[locale]}</p>
      </div>
      <details class="border-subtle mt-6 border-t pt-5">
        <summary class="cursor-pointer font-semibold">{text.stack}</summary>
        <ul class="mt-4 flex flex-wrap gap-2">
          {
            cceCaseStudy.technologies.map((technology) => (
              <li class="bg-brand-500/10 text-brand-700 dark:text-brand-300 rounded-md px-2.5 py-1 font-mono text-xs font-medium">
                {technology}
              </li>
            ))
          }
        </ul>
      </details>
    </div>
  </Section>

  <Section
    id="quality"
    kicker="Ingeniería"
    title={cceCaseStudy.quality.title[locale]}
    class="bg-brand-500/[0.035] dark:bg-white/[0.02]"
  >
    <ul class="grid gap-4 sm:grid-cols-2">
      {
        cceCaseStudy.quality.items[locale].map((item) => (
          <li class="surface-card spotlight reveal flex gap-3 p-5 leading-relaxed">
            <Icon name="check" class="text-brand-500 mt-1 size-4 shrink-0" />
            <span class="text-muted">{item}</span>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="results" kicker="Validación" title={text.metrics}>
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        cceCaseStudy.metrics.map((metric) => (
          <li class="surface-card spotlight reveal p-5">
            <p class="font-display text-brand-600 dark:text-brand-300 text-3xl font-bold">{metric.value}</p>
            <p class="mt-2 text-sm font-semibold">{metric.label[locale]}</p>
            <p class="text-muted mt-2 text-xs leading-relaxed">{metric.detail[locale]}</p>
          </li>
        ))
      }
    </ul>
    <div class="border-brand-400/35 bg-brand-500/5 mt-8 rounded-xl border p-5 sm:p-6">
      <p class="font-semibold">{cceCaseStudy.performanceNote[locale]}</p>
      <p class="text-muted mt-4 text-sm leading-relaxed">{cceCaseStudy.measurementNote[locale]}</p>
    </div>
  </Section>

  <Section
    id="next"
    kicker={cceCaseStudy.eyebrow[locale]}
    title={cceCaseStudy.next.title[locale]}
    class="bg-brand-500/[0.035] dark:bg-white/[0.02]"
  >
    <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr]">
      <p class="text-muted reveal text-lg leading-relaxed">{cceCaseStudy.next.lead[locale]}</p>
      <ul class="surface-card spotlight reveal space-y-4 p-6">
        {
          cceCaseStudy.next.items[locale].map((item) => (
            <li class="text-muted flex gap-3 leading-relaxed">
              <Icon name="arrowRight" class="text-brand-500 mt-1 size-4 shrink-0" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>
</BaseLayout>
