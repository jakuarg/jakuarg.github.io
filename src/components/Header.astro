---
import type { Locale } from '@/site.config';
import { useTranslations, localizePath } from '@/i18n/utils';
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname.slice(base.length) || '/';
const rest = currentPath.replace(/^\/en(?=\/|$)/, '') || '/';
const isHome = rest === '/';

/**
 * Selector de idioma: un enlace real por idioma, cada uno a su propia versión
 * de la página actual. Antes era un solo enlace al idioma alternativo, así que
 * el segmento resaltado como activo también llevaba al otro idioma.
 */
const idiomas = [
  { code: 'es' as const, etiqueta: 'ES', titulo: t('lang.toEs') },
  { code: 'en' as const, etiqueta: 'EN', titulo: t('lang.toEn') },
];

const links = [
  { href: isHome ? '#about' : `${localizePath('/', locale)}#about`, label: t('nav.about') },
  { href: isHome ? '#skills' : `${localizePath('/', locale)}#skills`, label: t('nav.skills') },
  { href: isHome ? '#projects' : `${localizePath('/', locale)}#projects`, label: t('nav.projects') },
  { href: isHome ? '#education' : `${localizePath('/', locale)}#education`, label: t('nav.education') },
  { href: isHome ? '#contact' : `${localizePath('/', locale)}#contact`, label: t('nav.contact') },
];
---

<a
  href="#main"
  class="bg-brand-600 sr-only rounded-md px-4 py-2 text-white focus-visible:not-sr-only focus-visible:absolute focus-visible:top-3 focus-visible:left-3 focus-visible:z-50"
>
  {t('nav.skip')}
</a>

<header
  data-header
  class="border-subtle sticky top-0 z-40 border-b border-transparent backdrop-blur-md transition-[background-color,border-color] duration-300"
>
  <nav class="mx-auto flex h-16 w-full max-w-5xl items-center justify-between px-5 sm:px-8" aria-label={t('nav.menu')}>
    <a href={localizePath('/', locale)} class="font-display text-lg font-bold tracking-tight">
      David<span class="text-brand-500">.</span>
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              data-nav-link
              class="text-muted hover:text-brand-600 dark:hover:text-brand-300 aria-[current=true]:text-brand-600 dark:aria-[current=true]:text-brand-300 rounded-md px-3 py-2 text-sm font-medium transition-colors"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <div
        role="group"
        aria-label={t('lang.label')}
        class="border-subtle focus-within:border-brand-400 hover:border-brand-400 flex h-10 items-center rounded-full border p-1 text-xs font-bold tracking-wide uppercase transition-colors"
      >
        {
          idiomas.map((idioma, indice) => (
            <>
              {indice > 0 && <Icon name="languages" class="text-muted mx-0.5 size-3.5 shrink-0" />}
              <a
                href={localizePath(rest, idioma.code)}
                hreflang={idioma.code}
                aria-label={idioma.titulo}
                aria-current={locale === idioma.code ? 'true' : undefined}
                title={idioma.titulo}
                class:list={[
                  'grid h-8 min-w-8 place-items-center rounded-full px-2 transition-colors',
                  locale === idioma.code
                    ? 'bg-brand-600 text-white shadow-sm'
                    : 'text-muted hover:text-brand-600 dark:hover:text-brand-300',
                ]}
              >
                {idioma.etiqueta}
              </a>
            </>
          ))
        }
      </div>
      <ThemeToggle label={t('theme.toggle')} />
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t('nav.menu')}
        class="border-subtle hover:border-brand-400 grid size-10 place-items-center rounded-full border transition-colors md:hidden"
      >
        <Icon name="menu" class="size-[18px]" />
      </button>
    </div>
  </nav>

  <div id="mobile-menu" data-menu hidden class="border-subtle border-t md:hidden" style="background: var(--surface);">
    <ul class="mx-auto max-w-5xl px-5 py-3 sm:px-8">
      {
        links.map((link) => (
          <li>
            <a href={link.href} data-menu-link class="hover:text-brand-600 block rounded-md px-2 py-3 font-medium">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  // Fondo del header solo cuando la página ya se desplazó.
  if (header) {
    const update = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
    };

    // `aria-expanded` es la fuente de verdad del estado abierto/cerrado.
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    toggle.addEventListener('click', () => setOpen(!isOpen()));
    menu.querySelectorAll('[data-menu-link]').forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });
    // Al pasar a escritorio el menú desplegable deja de tener sentido.
    matchMedia('(min-width: 768px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }

  // Resalta en la navegación la sección visible.
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const sections = navLinks
    .map((link) => document.querySelector<HTMLElement>(link.hash))
    .filter((section): section is HTMLElement => section !== null);

  if (sections.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          navLinks.forEach((link) => link.setAttribute('aria-current', String(link.hash === `#${entry.target.id}`)));
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((section) => observer.observe(section));
  }
</script>

<style>
  [data-header].is-scrolled {
    background-color: color-mix(in oklab, var(--surface) 82%, transparent);
    border-bottom-color: var(--border-subtle);
  }
</style>
